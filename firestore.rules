rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && userEmail() == 'jiranimwema202420@gmail.com';
    }

    function myGlobalMembershipId() {
      return 'membership_' + request.auth.uid;
    }

    function hasMyGlobalMembership() {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(myGlobalMembershipId()));
    }

    function myGlobalMembership() {
      return get(/databases/$(database)/documents/memberships/$(myGlobalMembershipId()));
    }

    function hasMyGroupMembership(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/memberships/$(request.auth.uid));
    }

    function myGroupMembership(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/memberships/$(request.auth.uid));
    }

    function roleIsMember(role) {
      return role in [
        'ADMIN',
        'Admin',
        'admin',
        'TREASURER',
        'Treasurer',
        'treasurer',
        'CHAIRPERSON',
        'Chairperson',
        'chairperson',
        'MEMBER',
        'Member',
        'member'
      ];
    }

    function roleIsAdmin(role) {
      return role in ['ADMIN', 'Admin', 'admin'];
    }

    function roleIsTreasurer(role) {
      return role in ['TREASURER', 'Treasurer', 'treasurer'];
    }

    function statusIsActive(status) {
      return !(status in ['disabled', 'Disabled', 'DISABLED', 'inactive', 'Inactive', 'INACTIVE', 'suspended', 'Suspended', 'SUSPENDED']);
    }

    function isGlobalGroupMember(groupId) {
      return hasMyGlobalMembership()
        && myGlobalMembership().data.groupId == groupId
        && roleIsMember(myGlobalMembership().data.role)
        && statusIsActive(myGlobalMembership().data.status);
    }

    function isGroupMember(groupId) {
      return hasMyGroupMembership(groupId)
        && roleIsMember(myGroupMembership(groupId).data.role)
        && statusIsActive(myGroupMembership(groupId).data.status);
    }

    function isMember(groupId) {
      return isBootstrapAdmin()
        || isGroupMember(groupId)
        || isGlobalGroupMember(groupId);
    }

    function isGroupAdmin(groupId) {
      return hasMyGroupMembership(groupId)
        && roleIsAdmin(myGroupMembership(groupId).data.role)
        && statusIsActive(myGroupMembership(groupId).data.status);
    }

    function isGlobalAdmin(groupId) {
      return hasMyGlobalMembership()
        && myGlobalMembership().data.groupId == groupId
        && roleIsAdmin(myGlobalMembership().data.role)
        && statusIsActive(myGlobalMembership().data.status);
    }

    function isAdmin(groupId) {
      return isBootstrapAdmin()
        || isGroupAdmin(groupId)
        || isGlobalAdmin(groupId);
    }

    function isGroupTreasurer(groupId) {
      return hasMyGroupMembership(groupId)
        && roleIsTreasurer(myGroupMembership(groupId).data.role)
        && statusIsActive(myGroupMembership(groupId).data.status);
    }

    function isGlobalTreasurer(groupId) {
      return hasMyGlobalMembership()
        && myGlobalMembership().data.groupId == groupId
        && roleIsTreasurer(myGlobalMembership().data.role)
        && statusIsActive(myGlobalMembership().data.status);
    }

    function isTreasurer(groupId) {
      return isGroupTreasurer(groupId)
        || isGlobalTreasurer(groupId);
    }

    function isFinanceOfficial(groupId) {
      return isAdmin(groupId) || isTreasurer(groupId);
    }

    function hasValidMembershipPayload(groupId) {
      return request.resource.data.groupId == groupId
        && roleIsMember(request.resource.data.role);
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create, update, delete: if isAdmin(groupId);

      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isAdmin(groupId);
      }

      match /contributions/{contributionId} {
        allow read: if isMember(groupId);
        allow create, update: if isFinanceOfficial(groupId);
        allow delete: if isAdmin(groupId);
      }

      match /monthlyRecipients/{recipientId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isFinanceOfficial(groupId);
      }

      match /settings/{settingId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isAdmin(groupId);
      }

      match /rounds/{roundId} {
        allow read: if isMember(groupId);
        allow create, update: if isFinanceOfficial(groupId);
        allow delete: if isAdmin(groupId);
      }

      match /insurance/{policyId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isAdmin(groupId);
      }

      match /bereavedCases/{caseId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isAdmin(groupId);
      }

      match /auditLogs/{logId} {
        allow read: if isFinanceOfficial(groupId);
        allow create: if isFinanceOfficial(groupId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /accessRequests/{requestId} {
        // Important fix:
        // A signed-in user must be allowed to read their own request document path
        // even before the document exists, otherwise getDoc(accessRequests/{uid})
        // throws "Missing or insufficient permissions".
        allow get: if isAdmin(groupId)
          || (signedIn() && requestId == request.auth.uid);

        allow list: if isAdmin(groupId);

        allow create: if signedIn()
          && requestId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.groupId == groupId
          && request.resource.data.status == 'Pending';

        allow update: if isAdmin(groupId)
          || (
            signedIn()
            && requestId == request.auth.uid
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.groupId == groupId
            && request.resource.data.status == 'Pending'
          );

        allow delete: if isAdmin(groupId);
      }

      match /memberships/{userId} {
        allow get: if signedIn() && (userId == request.auth.uid || isAdmin(groupId));
        allow list: if isAdmin(groupId);
        allow create, update: if isAdmin(groupId) && hasValidMembershipPayload(groupId);
        allow delete: if isAdmin(groupId);
      }

      // Optional protected location for future private member data.
      // Use this if you later split public member records from private contact/personal data.
      match /memberPrivateData/{memberId} {
        allow read, write: if isFinanceOfficial(groupId);
      }
    }

    match /memberships/{membershipId} {
      allow get: if signedIn()
        && (
          membershipId == myGlobalMembershipId()
          || isBootstrapAdmin()
          || isAdmin(resource.data.groupId)
        );

      allow list: if isBootstrapAdmin();

      allow create: if signedIn()
        && (
          isBootstrapAdmin()
          || isAdmin(request.resource.data.groupId)
        )
        && hasValidMembershipPayload(request.resource.data.groupId);

      allow update: if signedIn()
        && (
          isBootstrapAdmin()
          || isAdmin(resource.data.groupId)
        )
        && hasValidMembershipPayload(request.resource.data.groupId);

      allow delete: if signedIn()
        && (
          isBootstrapAdmin()
          || isAdmin(resource.data.groupId)
        );
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && (userId == request.auth.uid || isBootstrapAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}


